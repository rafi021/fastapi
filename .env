# PostgreSQL credentials — used by both postgres container and api container
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_db
DB_PORT=5432

# App config
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
DEBUG=True

# Local development only (outside Docker) — Docker Compose overrides this automatically
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_db
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest